{
    "name": "minddiary",
    "version": "1.11.0",
    "description": "考研日记桌面应用",
    "engines": {
        "node": ">=20.12.0"
    },
    "author": "MindDiary Team",
    "repository": {
        "type": "git",
        "url": "https://github.com/gakialter/Minddiary.git"
    },
    "main": "electron-dist/electron/main.js",
    "scripts": {
        "build:electron": "tsc -p tsconfig.electron.json",
        "build:resources": "npx tsx scripts/create-icon.ts",
        "dev": "npm run build:electron && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
        "electron:dev": "electron .",
        "postinstall": "electron-builder install-app-deps",
        "build": "npm run build:electron && vite build && npm run build:resources && electron-builder",
        "build:mac": "npm run build:electron && vite build && npm run build:resources && electron-builder --mac",
        "build:win": "npm run build:electron && vite build && npm run build:resources && electron-builder --win",
        "preview": "vite preview",
        "test": "vitest",
        "test:e2e": "playwright test",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json"
    },
    "dependencies": {
        "better-sqlite3": "^11.0.0",
        "dom-to-image-more": "^3.7.2",
        "dompurify": "^3.3.2",
        "electron-updater": "^6.8.3",
        "file-saver": "^2.0.5",
        "lucide-react": "^0.577.0",
        "marked": "^17.0.4",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-latex-next": "^3.0.0",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.59.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/better-sqlite3": "^7.6.13",
        "@types/dompurify": "^3.0.5",
        "@types/file-saver": "^2.0.7",
        "@types/node": "^25.6.0",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/coverage-v8": "^4.1.0",
        "autoprefixer": "^10.5.0",
        "concurrently": "^8.2.2",
        "electron": "^34.5.8",
        "electron-builder": "^26.8.1",
        "jsdom": "^29.0.1",
        "playwright": "^1.58.2",
        "png-to-ico": "^3.0.1",
        "postcss": "^8.5.9",
        "tailwindcss": "^3.4.19",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2",
        "vite": "^8.0.10",
        "vitest": "^4.0.18",
        "wait-on": "^7.2.0"
    },
    "build": {
        "appId": "com.minddiary.app",
        "productName": "MindDiary",
        "directories": {
            "output": "release",
            "buildResources": "build"
        },
        "publish": [
            {
                "provider": "github",
                "owner": "gakialter",
                "repo": "Minddiary"
            }
        ],
        "files": [
            "dist/**/*",
            "electron-dist/**/*",
            "package.json"
        ],
        "win": {
            "target": [
                "nsis",
                "portable"
            ],
            "icon": "build/icon.png"
        },
        "nsis": {
            "artifactName": "${productName}-Setup-${version}.${ext}",
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "MindDiary"
        },
        "portable": {
            "artifactName": "${productName}-Portable-${version}.${ext}"
        },
        "mac": {
            "target": [
                "dmg",
                "zip"
            ],
            "icon": "build/icon.png"
        }
    }
}
