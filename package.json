{
    "name": "minddiary",
    "version": "1.18.0",
    "description": "考研日记桌面应用",
    "engines": {
        "node": ">=22.12.0"
    },
    "author": "MindDiary Team",
    "repository": {
        "type": "git",
        "url": "https://github.com/gakialter/Minddiary.git"
    },
    "main": "electron-dist/electron/main.js",
    "scripts": {
        "build:electron": "tsc -p tsconfig.electron.json",
        "build:resources": "npx tsx scripts/create-icon.ts",
        "dev": "npm run build:electron && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
        "electron:dev": "electron .",
        "postinstall": "electron-builder install-app-deps",
        "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
        "verify:electron-native": "node scripts/verify-electron-native.mjs",
        "verify:electron-native:packaged": "node scripts/verify-electron-native.mjs --release-dir release",
        "verify:electron-package-security": "node scripts/verify-electron-package-security.mjs --release-dir release",
        "verify:electron-package-security:release": "node scripts/verify-electron-package-security.mjs --release-dir release --require-updater-metadata",
        "test:e2e:packaged-security": "playwright test --config playwright.packaged.config.ts",
        "test:e2e:portable-smoke": "playwright test --config playwright.portable.config.ts",
        "test:e2e:setup-smoke": "playwright test --config playwright.setup.config.ts",
        "test:e2e:updater": "tsx scripts/run-windows-updater-e2e.ts",
        "test:asar-integrity:packaged": "node scripts/test-packaged-asar-integrity.mjs --release-dir release",
        "build": "npm run build:electron && vite build && npm run build:resources && npm run rebuild:electron && npm run verify:electron-native && electron-builder && npm run verify:electron-package-security:release && npm run verify:electron-native:packaged",
        "build:mac": "npm run build:electron && vite build && npm run build:resources && npm run rebuild:electron && npm run verify:electron-native && electron-builder --mac && npm run verify:electron-package-security:release && npm run verify:electron-native:packaged",
        "build:win": "npm run build:electron && vite build && npm run build:resources && npm run rebuild:electron && npm run verify:electron-native && electron-builder --win && npm run verify:electron-package-security:release && npm run verify:electron-native:packaged",
        "preview": "vite preview",
        "test": "vitest",
        "test:e2e": "playwright test",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json"
    },
    "dependencies": {
        "better-sqlite3": "12.11.1",
        "dom-to-image-more": "^3.7.2",
        "electron-updater": "^6.8.9",
        "file-saver": "^2.0.5",
        "lucide-react": "^0.577.0",
        "marked": "^17.0.4",
        "pdfjs-dist": "^6.0.227",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-latex-next": "^3.0.0",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1"
    },
    "devDependencies": {
        "@electron/fuses": "2.1.2",
        "@electron/rebuild": "^4.2.0",
        "@playwright/test": "^1.61.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/better-sqlite3": "^7.6.13",
        "@types/file-saver": "^2.0.7",
        "@types/js-yaml": "4.0.9",
        "@types/node": "^25.6.0",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^6.0.3",
        "@vitest/coverage-v8": "^4.1.10",
        "autoprefixer": "^10.5.0",
        "concurrently": "^8.2.2",
        "electron": "42.6.1",
        "electron-builder": "^26.15.6",
        "js-yaml": "4.3.0",
        "jsdom": "^29.1.1",
        "playwright": "^1.61.1",
        "png-to-ico": "^3.0.1",
        "postcss": "^8.5.9",
        "tailwindcss": "^3.4.19",
        "tsx": "^4.23.0",
        "typescript": "^6.0.2",
        "vite": "^8.1.4",
        "vitest": "^4.1.10",
        "wait-on": "^7.2.0"
    },
    "overrides": {
        "prebuild-install": {
            "node-abi": "4.33.0"
        }
    },
    "build": {
        "appId": "com.minddiary.app",
        "productName": "MindDiary",
        "directories": {
            "output": "release",
            "buildResources": "build"
        },
        "publish": [
            {
                "provider": "github",
                "owner": "gakialter",
                "repo": "Minddiary"
            }
        ],
        "files": [
            "dist/**/*",
            "electron-dist/**/*",
            "package.json"
        ],
        "asar": {
            "smartUnpack": false
        },
        "asarUnpack": [
            "node_modules/better-sqlite3/build/Release/better_sqlite3.node"
        ],
        "electronFuses": {
            "runAsNode": false,
            "enableCookieEncryption": false,
            "enableNodeOptionsEnvironmentVariable": false,
            "enableNodeCliInspectArguments": false,
            "enableEmbeddedAsarIntegrityValidation": true,
            "onlyLoadAppFromAsar": true,
            "loadBrowserProcessSpecificV8Snapshot": false,
            "grantFileProtocolExtraPrivileges": true,
            "resetAdHocDarwinSignature": true
        },
        "win": {
            "target": [
                "nsis",
                "portable"
            ],
            "icon": "build/icon.png"
        },
        "nsis": {
            "artifactName": "${productName}-Setup-${version}.${ext}",
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "deleteAppDataOnUninstall": false,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "MindDiary"
        },
        "portable": {
            "artifactName": "${productName}-Portable-${version}.${ext}"
        },
        "mac": {
            "target": [
                "dmg",
                "zip"
            ],
            "icon": "build/icon.png",
            "minimumSystemVersion": "12.0"
        }
    }
}
